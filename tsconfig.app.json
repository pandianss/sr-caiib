{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client"], "skipLibCheck": true
  },
  "include": ["src/app/**/*.ts", "src/app/**/*.tsx", "src/core/**/*.ts", "src/storage/**/*.ts", "src/types/**/*.ts", "src/validation/**/*.ts"]
}

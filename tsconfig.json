{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"], "types": ["node"], "skipLibCheck": true
  },
  "include": ["src/types/**/*.ts", "src/validation/**/*.ts", "src/core/**/*.ts", "src/storage/**/*.ts", "server/**/*.ts", "tests/**/*.ts"]
}

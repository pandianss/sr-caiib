              "option_id": "A",
              "text_md": "5",
              "explanation_md": "Adding the two quantities does not count both equal lots."
            },
            {
              "option_id": "B",
              "text_md": "6",
              "explanation_md": "Two lots of three gives six."
            },
            {
              "option_id": "C",
              "text_md": "3",
              "explanation_md": "That counts only one lot."
            },
            {
              "option_id": "D",
              "text_md": "9",
              "explanation_md": "That would count three lots."
            }
          ],
          "correct_option_id": "B",

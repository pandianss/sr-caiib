# Copy to .env (never commit it) and export these variables for `npm run server`.
# Nothing here is a real credential.

APP_MODE=development                 # development | production
PORT=8787
APP_ORIGIN=http://localhost:5173     # comma-separated web origins allowed to call the API
DATA_DIR=./server/data               # SQLite database and (development only) generated signing key
BUSINESS_TIME_ZONE=Asia/Kolkata      # calendar used for the six-month access term
ACCESS_TERM_MONTHS=6
OFFLINE_LEASE_DAYS=30

# Payments: disabled | local_test (development simulation only) | razorpay
PAYMENT_PROVIDER=local_test
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# LIVE_PURCHASES_ENABLED=false       # must be "true", with rzp_live_ keys, before real money can be taken
# SUPPORT_TEXT=Support contact and refund terms shown to buyers before checkout (required with razorpay)

# Sign-in codes: log (development; printed to the server console) | http (POST {from,to,subject,text} as JSON)
MAIL_MODE=log
# MAIL_HTTP_URL=https://your-mail-service.example/send
# MAIL_HTTP_TOKEN=
# MAIL_FROM=no-reply@your-domain.example

# Production only: PEM file holding the P-256 private key that signs offline entitlements.
# ENTITLEMENT_PRIVATE_KEY_FILE=/secure/path/entitlement-key.pem
# STATIC_DIR=./dist
# CONTENT_DIR=./dist/content
